#!/usr/bin/env bash
# Show the Hubris task table on the emulated SP, via humility.
#
#   ./tasks              # the task table, over the SWD (Glasgow) debug port
#   ./tasks -sl net      # stack-backtrace a task
#
# The SWD debug port is a real halt/run/step debug core exposed as a Glasgow
# probe, and it is the only transport sp-emu still serves: the OpenOCD and
# GDB-RSP stubs this script once defaulted to were removed when humility dropped
# `-p ocd` and `-p ocdgdb`. The port follows the bridge
# (4444 + (SP_BASE - 33300)), so it works at any SP_BASE; $SWD_PORT overrides it.
#
# (Run this when the SP is idle -- i.e. not mid-MGS-command -- since humility
# halts the CPU to read memory.)

set -euo pipefail

# The build archive comes from the separate hubris repo; set $ARCHIVE to your build.
ARCHIVE="${ARCHIVE:-}"
[ -n "$ARCHIVE" ] && [ -f "$ARCHIVE" ] || {
  echo "[!] Set \$ARCHIVE to your hubris gimlet-c build archive (.zip)" >&2
  exit 1
}

# Accepted and ignored: the flag used to select this, now the only transport.
if [ "${1:-}" = "--swd" ]; then shift; fi

SP_BASE="${SP_BASE:-33310}"
SWD_PORT="${SWD_PORT:-$((4444 + SP_BASE - 33300))}"

exec humility -a "$ARCHIVE" -p "20b7:9db1:tcp:127.0.0.1:${SWD_PORT}" tasks "$@"
